# Copia este archivo como .env y completa los valores.

# --- Fuente de video ---
# Índice de cámara (0, 1...), ruta a un archivo o URL (rtsp://...).
# Si es un archivo, se repite en bucle.
VIDEO_SOURCE=videos/video-parking.mp4
VIDEO_RETRY_SECONDS=2

# --- Calibración de celdas (scripts/admin/configure_spaces.py) ---
# Imagen nítida con el MISMO encuadre del video. Las coordenadas se
# re-escalan al tamaño del video al guardar.
CALIBRATION_IMAGE=imagenes/imagen10.jpg
PARKING_CELLS=scripts/estacionamientos.json

# --- Detección con YOLO ---
YOLO_MODEL=scripts/yolo11n.pt
# Confianza baja a propósito para detectar las motos del fondo.
YOLO_CONFIDENCE=0.15
YOLO_IMAGE_SIZE=960
# Recortes por eje (2 = imagen completa + 4 recortes). 1 = sin recortes, más rápido.
YOLO_TILE_GRID=2
MIN_BOX_AREA=500
MIN_MOTORCYCLE_AREA=100
# Cuadros seguidos necesarios para cambiar una celda de libre a ocupada o al revés.
OCCUPANCY_FRAMES=3

# --- Placas (Roboflow) ---
ROBOFLOW_API_KEY=
ROBOFLOW_WORKSPACE=
ROBOFLOW_WORKFLOW=
PLATE_INTERVAL_FRAMES=15
PLATE_CONFIRMATION_READS=2
# Tiempo en que una placa ya confirmada no se vuelve a confirmar (solo esa placa).
PLATE_COOLDOWN_SECONDS=30
PLATE_REQUIRE_VEHICLE=true
# Formato de placa válido (expresión regular sobre el texto sin espacios ni guiones).
# Vacío = aceptar cualquier texto. Si no se define, se usa el formato colombiano:
#   carros ABC123, motos ABC12D
# Para el video de prueba alemán (B-PZ 1081):
# PLATE_PATTERN=^[A-Z]{2,5}[0-9]{1,4}[EH]?$
# Recortar cada vehículo detectado por YOLO y enviarlo a Roboflow por separado.
PLATE_CROP_VEHICLES=true
# Máximo de vehículos (los más grandes = más cercanos) por intento. Cada uno es una llamada a la API.
PLATE_MAX_VEHICLES=3
# Ancho mínimo en píxeles del vehículo; más pequeño, la placa no se alcanza a leer.
PLATE_MIN_CROP_WIDTH=120
# No leer placas de vehículos que ya están dentro de una celda.
PLATE_SKIP_PARKED=true
REGISTERED_VEHICLES=scripts/vehiculos_registrados.json
# Segundos que se guarda una celda asignada si el vehículo nunca se estaciona.
RESERVATION_TIMEOUT_SECONDS=600

# --- Sincronización con educore-backend ---
# Si está activa, cada placa confirmada y registrada además se asigna y se
# guarda en el backend (no solo en la reserva local en memoria).
BACKEND_SYNC_ENABLED=false
BACKEND_BASE_URL=http://localhost:8080
# Cuenta de servicio: un usuario con rol Operador (ya tiene los permisos
# ASSIGNMENTS_MANAGE y PLATES_VIEW que se necesitan).
BACKEND_SERVICE_USER_CODE=
BACKEND_SERVICE_IDENTITY_DOCUMENT=
BACKEND_SERVICE_PASSWORD=
# Id del parqueadero de esta cámara en el backend. Vacío = cualquiera con espacio libre.
BACKEND_PARKING_ID=
BACKEND_REQUEST_TIMEOUT_SECONDS=5
BACKEND_STUDENTS_CACHE_SECONDS=300
