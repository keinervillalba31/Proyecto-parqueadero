# Copia este archivo como .env y completa los valores.

# --- Fuente de video ---
# Índice de cámara (0, 1...), ruta a un archivo o URL (rtsp://...).
# Si es un archivo, se repite en bucle.
# Cámara del proyecto (EZVIZ): usuario admin y como clave el código de verificación de la
# etiqueta. Con `auto` como equipo, la cámara se busca en la red (ONVIF) en vez de usar
# una IP fija: sigue funcionando si cambia de IP o se lleva a otra red.
# /Streaming/Channels/101 = 2304x1296; /102 = 768x432 (más liviano).
VIDEO_SOURCE=rtsp://admin:CODIGO@auto:554/Streaming/Channels/101
# Identificador de la cámara (no cambia de red a red), por si en la red hay varias.
CAMERA_DISCOVERY_ID=f47018c853e7
# Fuente exclusiva para el servicio de placas (índice, ruta o URL).
# Si se deja vacía, la lectura de placas usa el flujo VIDEO_SOURCE como antes.
PLATE_VIDEO_SOURCE=
VIDEO_RETRY_SECONDS=2
# Video que se repite en bucle mientras la cámara de VIDEO_SOURCE no responde.
# Cuando la cámara aparece, el servicio cambia a ella solo. Vacío = sin respaldo.
VIDEO_FALLBACK=
# Cada cuántos segundos se reintenta la cámara mientras se usa el respaldo.
VIDEO_CAMERA_RETRY_SECONDS=10
# Dónde escucha el servicio.
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8000
# Orígenes web que pueden llamar al servicio desde el navegador (editor de celdas de la plataforma), separados por coma.
CORS_ORIGINS=http://localhost:4200
# Dirección con la que los navegadores llegan a este servicio; se envía sola a Monitoreo.
# Vacío = la IP que tenga este equipo en la red en ese momento.
SERVICE_PUBLIC_URL=
# Archivo donde se guarda lo que se deja encendido o apagado desde el panel.
# SERVICES_STATE=servicios_activos.json

# --- Calibración de celdas (scripts/admin/configure_spaces.py) ---
# Imagen nítida con el MISMO encuadre del video. Las coordenadas se
# re-escalan al tamaño del video al guardar.
CALIBRATION_IMAGE=imagenes/imagen10.jpg
PARKING_CELLS=scripts/estacionamientos.json

# --- Detección con YOLO ---
YOLO_MODEL=scripts/yolo11n.pt
# Confianza baja a propósito para detectar las motos del fondo.
YOLO_CONFIDENCE=0.15
YOLO_IMAGE_SIZE=960
# Recortes por eje (2 = imagen completa + 4 recortes). 1 = sin recortes, más rápido.
# El video siempre va en tiempo real; esto solo cambia cada cuánto se actualizan
# las cajas y las celdas. Sin GPU: 2 analiza ~1-2 veces por segundo y detecta más
# vehículos lejanos; 1 analiza ~5 veces por segundo y pierde algunos de los más pequeños.
YOLO_TILE_GRID=1
MIN_BOX_AREA=500
MIN_MOTORCYCLE_AREA=100
# Segundos seguidos viendo un vehículo para dar un puesto por ocupado, y sin verlo para darlo por libre.
# Liberar pide más tiempo porque YOLO pierde a ratos los carros lejanos o tapados.
OCCUPANCY_OCCUPY_SECONDS=2
OCCUPANCY_FREE_SECONDS=8

# --- Placas (Roboflow) ---
ROBOFLOW_API_KEY=
ROBOFLOW_WORKSPACE=
ROBOFLOW_WORKFLOW=
PLATE_INTERVAL_FRAMES=15
PLATE_CONFIRMATION_READS=2
# Tiempo en que una placa ya confirmada no se vuelve a confirmar (solo esa placa).
PLATE_COOLDOWN_SECONDS=30
# Espera corta cuando el backend conoce la placa pero aún no aplica (el estudiante ya
# tiene puesto, no hay cupo): se vuelve a consultar pronto por si eso cambió.
PLATE_RECHECK_SECONDS=4
# Segundos máximos de espera a Roboflow por cada lectura.
PLATE_OCR_TIMEOUT_SECONDS=30
PLATE_REQUIRE_VEHICLE=true
# Formato de placa válido (expresión regular sobre el texto sin espacios ni guiones).
# Vacío = aceptar cualquier texto. Si no se define, se usa el formato colombiano:
#   carros ABC123, motos ABC12D
# Para el video de prueba alemán (B-PZ 1081):
# PLATE_PATTERN=^[A-Z]{2,5}[0-9]{1,4}[EH]?$
# Recortar cada vehículo detectado por YOLO y enviarlo a Roboflow por separado.
PLATE_CROP_VEHICLES=true
# Máximo de vehículos (los más grandes = más cercanos) por intento. Cada uno es una llamada a la API.
PLATE_MAX_VEHICLES=3
# Ancho mínimo en píxeles del vehículo; más pequeño, la placa no se alcanza a leer.
PLATE_MIN_CROP_WIDTH=120
# No leer placas de vehículos que ya están dentro de una celda.
PLATE_SKIP_PARKED=true
REGISTERED_VEHICLES=scripts/vehiculos_registrados.json
# Segundos que se guarda una celda asignada si el vehículo nunca se estaciona.
RESERVATION_TIMEOUT_SECONDS=600

# --- Sincronización con educore-backend ---
# Si está activa, cada placa confirmada y registrada además se asigna y se
# guarda en el backend (no solo en la reserva local en memoria).
BACKEND_SYNC_ENABLED=false
BACKEND_BASE_URL=http://localhost:8080
# Cuenta de servicio: un usuario con rol Operador (ya tiene los permisos
# ASSIGNMENTS_MANAGE y PLATES_VIEW que se necesitan).
BACKEND_SERVICE_USER_CODE=
BACKEND_SERVICE_IDENTITY_DOCUMENT=
BACKEND_SERVICE_PASSWORD=
# Id del parqueadero de esta cámara en el backend. Vacío = cualquiera con espacio libre.
BACKEND_PARKING_ID=
# Id de esta cámara en la plataforma (módulo Monitoreo). Si se define, las celdas
# se toman de lo que el administrador trazó allí y se recargan solas al cambiar;
# si está vacío o la plataforma no tiene celdas, se usa PARKING_CELLS (archivo local).
# También se usa para avisar a Monitoreo si la cámara está en línea.
BACKEND_CAMERA_ID=3
BACKEND_CELLS_POLL_SECONDS=15
# Cada cuántos segundos se consultan los interruptores de Monitoreo (espacios y placas).
BACKEND_SERVICES_POLL_SECONDS=3
BACKEND_REQUEST_TIMEOUT_SECONDS=5
BACKEND_STUDENTS_CACHE_SECONDS=300
