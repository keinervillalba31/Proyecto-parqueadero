# Valores de la demo del parqueadero Archivos (grabación del 18-nov-2026).
# Copia .env.example como .env (si aún no tienes .env) y reemplaza en él estas variables por las de aquí.
# No lleva claves: la contraseña de la cuenta de servicio la pone cada quien.

# --- Video de la demo ---
# El video NO está en el repositorio (pesa 15,6 GB; GitHub no acepta más de 100 MB por archivo).
# Descárgalo del enlace de Google Drive que se comparte aparte y guárdalo EXACTAMENTE en esta ruta,
# dentro de la carpeta del proyecto (la carpeta videos/ no se sube a git):
#     videos/parqueadero-18nov/parqueadero-18nov-dia-completo.mp4
# Es el día completo a velocidad real (10,3 h, de 7:40 a 18:00) y se repite en bucle.
VIDEO_SOURCE=videos/parqueadero-18nov/parqueadero-18nov-dia-completo.mp4
# Respaldo opcional: el mismo día acelerado (20,7 min, 1,8 GB), también por Drive, en:
#     videos/parqueadero-18nov/dia-completo-acelerado.mp4
# Si no lo descargas, deja VIDEO_FALLBACK vacío.
VIDEO_FALLBACK=videos/parqueadero-18nov/dia-completo-acelerado.mp4
VIDEO_CAMERA_RETRY_SECONDS=5

# --- Detector ajustado para esta cámara (ve los carros pequeños del fondo) ---
# Con el lote lleno marca ~38 de ~40 carros (con los valores por defecto marcaba ~19).
YOLO_CONFIDENCE=0.10
YOLO_IMAGE_SIZE=1280
YOLO_TILE_GRID=1
MIN_BOX_AREA=150
# Ocupar con 1 s viendo el carro y liberar tras 30 s sin verlo: el detector pierde a ratos los carros lejanos.
OCCUPANCY_OCCUPY_SECONDS=1
OCCUPANCY_FREE_SECONDS=30

# --- Conexión con el backend ---
BACKEND_SYNC_ENABLED=true
BACKEND_BASE_URL=http://localhost:8080
# Cuenta de servicio: crea en la plataforma (Usuarios) un usuario con rol Operador y pon aquí sus datos.
BACKEND_SERVICE_USER_CODE=servicio.ia
BACKEND_SERVICE_IDENTITY_DOCUMENT=SERVICIOIA
BACKEND_SERVICE_PASSWORD=
# El id que imprime demo/archivos-18nov/cargar_demo.py al crear la cámara.
BACKEND_CAMERA_ID=
